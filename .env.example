# Only Nginx publishes a host port. Defaults work without creating .env.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# API containers always listen internally on 0.0.0.0:3000.
# For native development, the API reads these values from the root .env.
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
SWAGGER_ENABLED=true
TRUST_PROXY=false

# Production Compose defaults to NODE_ENV=production and Swagger disabled.
# To explicitly enable documentation in production-like local validation:
PRODUCTION_SWAGGER_ENABLED=false

# Local development only. Native API connects to the Docker PostgreSQL port.
DATABASE_URL=postgresql://breadcrumbs:breadcrumbs_local@localhost:5432/breadcrumbs
POSTGRES_PASSWORD=breadcrumbs_local
DATABASE_PORT=5432
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=BreadCrumbs <no-reply@breadcrumbs.local>
PUBLIC_APP_URL=http://localhost:8080

# Production: set a unique database password and your real SMTP host/sender.
# SMTP requires verified TLS in production (STARTTLS or SMTPS).
# URL-encode special characters in database passwords used in URLs.
# If needed, set DOCKER_DATABASE_URL with the encoded password and host postgres;
# keep POSTGRES_PASSWORD as the actual unencoded database password.
