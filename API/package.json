{
  "name": "roadmaps-api",
  "version": "0.0.1",
  "description": "API BreadCrumbs: trilhas de conhecimento e comunidade.",
  "author": "",
  "private": true,
  "engines": {
    "node": "^24.15.0 || ^26.0.0"
  },
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "db:migrate": "node --env-file-if-exists=../.env --env-file-if-exists=.env scripts/migrate.mjs",
    "smoke:product": "node --env-file-if-exists=../.env --env-file-if-exists=.env scripts/smoke-product.mjs",
    "prestart:dev": "npm run db:migrate",
    "prestart:prod": "npm run db:migrate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format:check": "prettier --check .",
    "docs:openapi": "npm run build && node scripts/export-openapi.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "nodemailer": "10.0.13",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "12.1.2",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.2"
  }
}
